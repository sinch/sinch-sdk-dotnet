<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Sinch\Sinch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sinch" Version="1.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="sms\obj\project.assets.json" />
    <_ContentIncludedByDefault Remove="sms\obj\SmsWebhookTemplate.csproj.nuget.dgspec.json" />
  </ItemGroup>
</Project>
